# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env*
!.env.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
out/
build
dist

# claude code — track skills, ignore local settings
.claude/*
!.claude/skills/

# pi coding agent — commit shared skills/prompts, ignore personal config & artifacts
.pi/*
!.pi/skills/
!.pi/prompts/
!.pi/agents/
!.pi/chains/

# personal agent config & local artifacts (never commit)
.pi/settings.json
.pi/.mung/
.pi/npm/
.pi/sessions/

# pi subagents (auto-generated workspace)
.pi-subagents/

# maps local cache (pmtiles + glyphs, machine-local)
.maps-cache/

# other AI tools
.codegraph/
*-draft.md

# VSCode
.vscode/*.local.json
.vscode/*.code-snippets
!.vscode/settings.json

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
*.pid
*.tsbuildinfo
*.db
temp/
.tmp/
.snapshot-*.json

# Logs
logs/
*.log

