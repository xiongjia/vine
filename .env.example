# Vine maps-cli — object storage credentials
# Copy to .env (gitignored) and fill in your values. The CLI loads
# .env / .env.local from the repo root. See docs/distribution.md §2.

# --- Cloudflare R2 (S3-compatible endpoint) ---
VINE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
VINE_R2_ACCESS_KEY=
VINE_R2_SECRET_KEY=
VINE_R2_BUCKET=vine-maps
VINE_R2_REGION=auto

# --- AWS S3 (uncomment to use instead of R2) ---
# VINE_S3_REGION=ap-northeast-1
# VINE_S3_ACCESS_KEY=
# VINE_S3_SECRET_KEY=
# VINE_S3_BUCKET=vine-maps

# --- optional ---
# Storage root directory inside the bucket (default: vine)
# VINE_STORAGE_ROOT=vine
# Relocate the local pmtiles/glyphs cache (default: <repo root>/.maps-cache)
# VINE_MAPS_CACHE=/path/to/.maps-cache
# Override the external pmtiles binary (default: auto-detect pmtiles / go-pmtiles)
# VINE_PMTILES_BIN=/path/to/pmtiles
# Route uploads through a proxy (read at process start; NO_PROXY not honored)
# HTTPS_PROXY=http://127.0.0.1:1095
